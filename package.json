{
  "name": "uib-karaktersnitt",
  "productName": "UiB Karaktersnitt",
  "version": "1.0.0",
  "description": "Beregn vektet karaktersnitt etter UiB sine regler.",
  "main": "main.js",
  "author": "Even Kirkeluten",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.kirkeluten.uibkaraktersnitt",
    "productName": "UiB Karaktersnitt",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "UiB Karaktersnitt"
    }
  }
}
